# Mapbox access token (required for the Streets / Dark / Satellite map styles).
# Get one for free at https://account.mapbox.com/access-tokens/
# The "Balad" style works without a token because it is served from raah.ir.
VITE_MAPBOX_TOKEN=

# Public site URL for SEO (sitemap, Open Graph). Set to your real domain before deploying.
VITE_SITE_URL=https://www.langarnama.ir
